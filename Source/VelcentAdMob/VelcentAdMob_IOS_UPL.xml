<?xml version="1.0" encoding="utf-8"?>
<root>
	<init>
		<log text="VelcentAdMob iOS init"/>
		<setBoolFromProperty result="bVelcentAdMobEnabled" ini="Engine" section="/Script/VelcentAdMob.VelcentAdMobSettings" property="bEnableAdMob" default="true"/>
		<setStringFromProperty result="VelcentAdMobIOSAppId" ini="Engine" section="/Script/VelcentAdMob.VelcentAdMobSettings" property="IOSAdMobApplicationId" default="ca-app-pub-3940256099942544~1458002511"/>
	</init>

	<iosPListUpdates>
		<if condition="bVelcentAdMobEnabled">
			<true>
				<addElements tag="dict" once="true">
					<key>GADApplicationIdentifier</key>
					<string>$S(VelcentAdMobIOSAppId)</string>
					<key>SKAdNetworkItems</key>
					<array>
						<dict>
							<key>SKAdNetworkIdentifier</key>
							<string>cstr6suwn9.skadnetwork</string>
						</dict>
					</array>
				</addElements>
			</true>
		</if>
	</iosPListUpdates>
</root>
